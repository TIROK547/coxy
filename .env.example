TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=coxysession

# Channels
PROXY_CHANNELS_FILE=collectors/channels/proxy_channels.lst
CONFIG_CHANNELS_FILE=collectors/channels/config_channels.lst

# Output
OUTPUT_DIR=output
RAW_CONFIGS_FILE=output/raw_configs.txt
RAW_PROXIES_FILE=output/raw_proxies.txt
OUTPUT_CONFIGS_FILE=output/result_configs.csv
OUTPUT_PROXIES_FILE=output/result_proxies.txt

TOP_N=20

# Telegram connection proxy (optional)
#
# Use this if Telegram is blocked where you're running coxy, instead of
# toggling a system-wide VPN on and off around the scrape steps. Leave empty
# to connect directly. Can also be set per-run with --proxy, which takes
# priority over this value.
#
# Formats:
#   socks5://[user:pass@]host:port
#   socks4://[user:pass@]host:port
#   http://[user:pass@]host:port
#   mtproxy://secret@host:port      (e.g. from a tg://proxy link)
TELEGRAM_PROXY=

# Message scraping
MESSAGES_PER_CHANNEL=40

# How many channels collect-configs/collect-proxies scan at the same time,
# instead of one after another. Higher = faster, but more likely to hit
# Telegram's rate limits. Override per-run with -j/--channel-concurrency.
CHANNEL_CONCURRENCY=5

# xray-knife (config testing)
XRAY_KNIFE=/usr/bin/xray-knife
XRAY_KNIFE_THREADS=20

# MTProto proxy testing
PROXY_CHECK_TIMEOUT=5
PROXY_CHECK_CONCURRENCY=300
