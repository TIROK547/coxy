# Telegram API credentials — from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=collector

# Input
CHANNELS_FILE=channels.lst

# Output
OUTPUT_DIR=output
RAW_CONFIGS_FILE=output/raw_configs.txt
RAW_PROXIES_FILE=output/raw_proxies.txt
RANKED_CONFIGS_FILE=output/ranked.csv
TOP_N=20

# Message scraping
MESSAGES_PER_CHANNEL=10

# xray-knife (config testing)
XRAY_KNIFE_PATH=/opt/xray-knife/xray-knife
XRAY_KNIFE_THREADS=20

# MTProto proxy testing
PROXY_CHECK_TIMEOUT=5
PROXY_CHECK_CONCURRENCY=300
