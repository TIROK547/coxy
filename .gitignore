# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
*.pem
*.key
*.crt

# Telethon session (as sensitive as .env — grants account access)
*.session
*.session-journal

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.dmypy.json
.pyre/

# Jupyter Notebook
.ipynb_checkpoints/

# IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Generated output — never commit scrape/test results
output/
data/
*.log
#*.csv
*.sqlite3
*.db

# Temporary files
*.tmp
*.bak
*.swp
